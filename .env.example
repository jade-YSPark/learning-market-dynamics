# .env.example
# 이 파일은 프로젝트에 필요한 환경 변수의 예시입니다.
# 이 파일의 이름을 .env 로 복사한 후, 아래의 YOUR_..._KEY 값들을 실제 키로 채워주세요.
# .env 파일은 .gitignore에 의해 Git 저장소에 포함되지 않습니다.

# Alpaca API Keys (Paper Trading)
ALPACA_API_KEY="YOUR_ALPACA_API_KEY"
ALPACA_SECRET_KEY="YOUR_ALPACA_SECRET_KEY"

# Coinbase API Keys
COINBASE_API_KEY="YOUR_COINBASE_API_KEY"
COINBASE_API_SECRET="YOUR_COINBASE_API_SECRET"

# FRED API Key (Optional)
FRED_API_KEY="YOUR_FRED_API_KEY"

# The Graph API Keys (Optional)
THE_GRAPH_AAVE_V3_ETHEREUM="YOUR_AAVE_SUBGRAPH_API_KEY"
THE_GRAPH_CURVE_FINANCE="YOUR_CURVE_SUBGRAPH_API_KEY"
